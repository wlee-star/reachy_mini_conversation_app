# Optional realtime input transcription language.
# Defaults to "en". Set to a backend-supported code such as "zh" for Chinese.
# REALTIME_TRANSCRIPTION_LANGUAGE="en"

# Hugging Face connection mode: "deployed" or "local".
# deployed = cloud inference via the Hugging Face session proxy. Privacy leak.
# local = your AI PC (speech-to-speech on port 8765). Intended runtime for this project.
HF_REALTIME_CONNECTION_MODE="local"

# Direct OpenAI-compatible realtime websocket for the local speech-to-speech server.
# Same machine: 127.0.0.1. Wireless Reachy: the AI PC's LAN IP. Port stays 8765.
HF_REALTIME_WS_URL="ws://127.0.0.1:8765/v1/realtime"

# Optional path to Hermes Agent config used to import HTTP MCP servers
# (Apex, Home Assistant, local time/weather). Stdio Hermes servers are skipped.
# HERMES_CONFIG_PATH=C:\Users\you\.hermes\config.yaml

# Hermes Agent API server for advanced delegated live-data tasks (bus, research, analysis).
# Same machine as Hermes: 127.0.0.1:8642. HERMES_API_KEY must match API_SERVER_KEY
# in %LOCALAPPDATA%\hermes\.env (at least 16 characters). Restart Hermes after changing it.
# HERMES_GATEWAY_URL=http://127.0.0.1:8642/v1/chat/completions
# HERMES_API_KEY=
# Advanced delegated Hermes queries can take 1–3 minutes; the app waits 180s before timing out.
# Interactive Reef trend checks wait 15s for live Hermes, then fall back to the Reef cache.
# HERMES_REQUEST_TIMEOUT_SECONDS=180
# HERMES_REEF_REQUEST_TIMEOUT_SECONDS=15
# After this many consecutive Hermes failures, skip live Hermes briefly and use safe fallbacks.
# HERMES_CIRCUIT_FAILURE_THRESHOLD=2
# HERMES_CIRCUIT_COOLDOWN_SECONDS=60

# Home Assistant Green local REST API. Used by the local home_assistant tool for
# simple state reads, light on/off, and scene activation without a Hermes hop.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# Optional Home Assistant sensor for the next bus. Defaults to sensor.route_311_at_rockwall_cres.
# HA_BUS_ENTITY_ID=sensor.route_311_at_rockwall_cres

# Local Neptune Apex Fusion status JSON. Used by apex and reef_status.
APEX_STATUS_URL=http://192.168.0.143:8080/status
# Optional Reef/Hermes fallback-cache age threshold in seconds. Default 3600.
# Used only when Hermes is unavailable. Current Hermes freshness uses the
# reef-monitor 60-second live-cache cadence, not this fallback threshold.
# REEF_CACHE_MAX_AGE_SECONDS=3600

# Hugging Face token for accessing datasets/models
HF_TOKEN=

# Optional built-in profile selector. Use a folder name from profiles/.
# If unset, the app uses the default profile unless startup settings were saved from the UI.
# REACHY_MINI_CUSTOM_PROFILE=mars_rover

# Optional external profile/tool directories
# REACHY_MINI_EXTERNAL_PROFILES_DIRECTORY=external_content/external_profiles
# REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY=external_content/external_tools

# Optional: discover and auto-load all tools found in REACHY_MINI_EXTERNAL_TOOLS_DIRECTORY,
# even if they are not enabled by the selected profile or its Tool access override.
# This is convenient for downloaded tools used with built-in/default profiles.
# AUTOLOAD_EXTERNAL_TOOLS=1

# Minutes of inactivity before Reachy Mini goes to sleep and the app stops. Default 1440 (one day), 0 disables.
# REACHY_MINI_APP_TIMEOUT_MINUTES=1440

# Conversational assistant identity. Wally is the assistant; Reachy Mini is the robot.
# ASSISTANT_NAME=Wally
# WAKE_NAME=Wally
# ROBOT_NAME=Reachy Mini
# Seconds of follow-up conversation after saying Wally before the wake name is required again.
# ACTIVE_SESSION_TIMEOUT_SECONDS=30

# IANA timezone for Wally's local clock and startup time context. Default Australia/Sydney.
# LOCAL_TIMEZONE=Australia/Sydney

# LAN hostname or IP of a physical Reachy Mini daemon when Windows cannot
# resolve reachy-mini.local. Example: 192.168.0.50
# When set to a non-localhost address, the conversation app will not launch the
# MuJoCo simulator. Leave unset to auto-start reachy-mini-daemon --sim.
# REACHY_DAEMON_HOST=
