{
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8788,
    "poll_interval_s": 3,
    "auto_restart_max": 3,
    "development_mode": true
  },
  "paths": {
    "conversation_root": "{repo_root}",
    "ai_stack_root": "{ai_stack_root}",
    "conversation_env": "{repo_root}/.env"
  },
  "services": [
    {
      "id": "llama",
      "name": "llama.cpp",
      "group": "ai",
      "description": "Local LLM server used by speech-to-speech.",
      "managed": true,
      "required": true,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 8080,
      "depends_on": [],
      "health": "llama",
      "process_match": "llama-server",
      "ready_timeout_s": 180,
      "start": {
        "executable": "llama-server",
        "args": [
          "-hf", "ggml-org/gemma-4-E4B-it-GGUF",
          "-np", "2",
          "-c", "65536",
          "-fa", "on",
          "--swa-full",
          "--host", "127.0.0.1",
          "--port", "8080"
        ],
        "cwd": "{ai_stack_root}"
      }
    },
    {
      "id": "speech",
      "name": "Speech-to-speech",
      "group": "ai",
      "description": "Hugging Face realtime voice server (Parakeet STT + Qwen TTS).",
      "managed": true,
      "required": true,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 8765,
      "depends_on": ["llama"],
      "health": "speech",
      "process_match": "speech-to-speech|speech_to_speech",
      "ready_timeout_s": 300,
      "start": {
        "executable": "{speech_python}",
        "args": [
          "-u",
          "-m",
          "speech_to_speech.s2s_pipeline",
          "--mode", "realtime",
          "--stt", "parakeet-tdt",
          "--tts", "qwen3",
          "--llm_backend", "responses-api",
          "--model_name", "ggml-org/gemma-4-E4B-it-GGUF",
          "--responses_api_base_url", "http://127.0.0.1:8080/v1",
          "--responses_api_api_key", "",
          "--ws_host", "127.0.0.1",
          "--ws_port", "8765",
          "--qwen3_tts_backend", "torch",
          "--qwen3_tts_device", "cuda"
        ],
        "cwd": "{ai_stack_root}"
      }
    },
    {
      "id": "qwen_tts",
      "name": "Qwen TTS",
      "group": "ai",
      "description": "Text-to-speech backend bundled inside speech-to-speech (--tts qwen3).",
      "managed": false,
      "required": true,
      "auto_restart": false,
      "depends_on": ["speech"],
      "health": "qwen_tts",
      "process_match": "speech-to-speech|speech_to_speech"
    },
    {
      "id": "hermes",
      "name": "Hermes",
      "group": "tools",
      "description": "Hermes Agent API for delegated live-data tasks.",
      "managed": true,
      "required": false,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 8642,
      "depends_on": [],
      "health": "hermes",
      "process_match": "hermes_cli\\.main.*\\bgateway\\b|hermes(\\.exe)?[\\s\\\"].*\\bgateway\\b|hermes-gateway",
      "ready_timeout_s": 45,
      "needs": ["HERMES_GATEWAY_URL", "HERMES_API_KEY"],
      "start": {
        "executable": "{hermes_exe}",
        "args": ["gateway", "start"],
        "cwd": "{hermes_home}"
      },
      "stop_args": ["gateway", "stop"]
    },
    {
      "id": "conversation",
      "name": "Conversation app",
      "group": "system",
      "description": "Reachy Mini conversation application (console + optional web UI).",
      "managed": true,
      "required": true,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 7860,
      "depends_on": ["llama", "speech", "reachy_daemon"],
      "health": "conversation",
      "process_match": "reachy-mini-conversation-app|reachy_mini_conversation_app",
      "ready_timeout_s": 90,
      "start": {
        "executable": "{conversation_python}",
        "args": ["-m", "reachy_mini_conversation_app.main", "--no-camera", "--no-sim", "--ui"],
        "cwd": "{conversation_root}"
      }
    },
    {
      "id": "reachy_daemon",
      "name": "Reachy Mini",
      "group": "system",
      "description": "Virtual Reachy Mini SDK daemon (MuJoCo sim) for local testing.",
      "managed": true,
      "required": true,
      "auto_restart": true,
      "host": "127.0.0.1",
      "port": 8000,
      "depends_on": [],
      "health": "reachy_daemon",
      "process_match": "reachy-mini-daemon.*--sim",
      "ready_timeout_s": 90,
      "start": {
        "executable": "{daemon_exe}",
        "args": [
          "--sim",
          "--fastapi-host", "127.0.0.1",
          "--fastapi-port", "8000"
        ],
        "gui": true,
        "cwd": "{conversation_root}"
      }
    },
    {
      "id": "home_assistant",
      "name": "Home Assistant",
      "group": "tools",
      "description": "Local Home Assistant REST API used by the home_assistant tool.",
      "managed": false,
      "required": false,
      "auto_restart": false,
      "depends_on": [],
      "health": "home_assistant",
      "needs": ["HA_URL", "HA_TOKEN"]
    },
    {
      "id": "apex",
      "name": "Neptune Apex",
      "group": "tools",
      "description": "Neptune Apex Fusion /status JSON used by apex and reef_status.",
      "managed": false,
      "required": false,
      "auto_restart": false,
      "depends_on": [],
      "health": "apex",
      "needs": ["APEX_STATUS_URL"]
    },
    {
      "id": "bus",
      "name": "Bus API",
      "group": "tools",
      "description": "Bus arrivals via the configured Home Assistant bus sensor.",
      "managed": false,
      "required": false,
      "auto_restart": false,
      "depends_on": ["home_assistant"],
      "health": "bus",
      "needs": ["HA_URL", "HA_TOKEN"]
    }
  ]
}
