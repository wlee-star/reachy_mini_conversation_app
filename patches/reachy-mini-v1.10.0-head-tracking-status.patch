+def test_daemon_status_reports_authoritative_head_tracking_state() -> None:
+    """Daemon status should report tracking state independently of face detection."""
+    backend = _make_backend()
+    daemon = Daemon(no_media=True)
+    daemon.backend = backend
+    daemon._status = DaemonStatus(
+        robot_name="reachy_mini",
+        state=DaemonState.RUNNING,
+        wireless_version=False,
+        desktop_app_daemon=False,
+        simulation_enabled=True,
+        mockup_sim_enabled=True,
+        backend_status=None,
+    )
+
+    status = daemon.status()
+    assert status.head_tracking_enabled is False
+    assert status.face_target.detected is False
+    assert status.face_target.ts is None
+
+    backend._media_server = SimpleNamespace(camera_specs=object())
+    backend._tracker = DummyTracker()
+    assert backend.enable_head_tracking() is True
+
+    status = daemon.status()
+    assert status.head_tracking_enabled is True
+    assert status.face_target.detected is False
+    assert status.face_target.ts is None
+
+    backend.set_tracking_face(
+        center=None,
+        roll=None,
+        width=640,
+        height=480,
+        camera_matrix=np.eye(3, dtype=np.float64),
+        distortion=np.zeros(5, dtype=np.float64),
+        timestamp=10.0,
+    )
+    status = daemon.status()
+    assert status.head_tracking_enabled is True
+    assert status.face_target.detected is False
+    assert status.face_target.ts == 10.0
+
+    backend.set_tracking_face(
+        center=(0.0, 0.0),
+        roll=0.0,
+        width=640,
+        height=480,
+        camera_matrix=np.array(
+            [[640.0, 0.0, 320.0], [0.0, 640.0, 240.0], [0.0, 0.0, 1.0]],
+            dtype=np.float64,
+        ),
+        distortion=np.zeros(5, dtype=np.float64),
+        timestamp=11.0,
+    )
+    status = daemon.status()
+    assert status.head_tracking_enabled is True
+    assert status.face_target.detected is True
+    assert status.face_target.ts == 11.0
+
+    backend.disable_head_tracking()
+    status = daemon.status()
+    assert status.head_tracking_enabled is False
+    assert status.face_target.detected is False
+    assert status.face_target.ts is None
+
+
+def test_daemon_status_defaults_tracking_state_for_older_daemon_payload() -> None:
+    """A status payload from an older daemon should report unknown tracking state."""
+    status = DaemonStatus.model_validate(
+        {
+            "type": "daemon_status",
+            "robot_name": "reachy_mini",
+            "state": "running",
+            "wireless_version": False,
+            "desktop_app_daemon": False,
+            "simulation_enabled": False,
+            "mockup_sim_enabled": False,
+            "backend_status": None,
+        }
+    )
+
+    assert status.head_tracking_enabled is None
+
+
